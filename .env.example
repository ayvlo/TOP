# Database
# Option 1: Local PostgreSQL
DATABASE_URL="postgresql://user:password@localhost:5432/ayvlo"

# Option 2: Supabase (recommended - see SETUP_WITH_SUPABASE.md)
# DATABASE_URL="postgresql://postgres:YourPassword@db.xxx.supabase.co:5432/postgres"
# DIRECT_URL="postgresql://postgres:YourPassword@db.xxx.supabase.co:5432/postgres"

# Option 3: Neon
# DATABASE_URL="postgresql://user:password@ep-xxx.aws.neon.tech/ayvlo"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-nextauth-secret-here-min-32-chars"

# OAuth Providers
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GITHUB_CLIENT_ID="your-github-client-id"
GITHUB_CLIENT_SECRET="your-github-client-secret"

# Stripe
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_PRICE_ID_STARTER="price_..."
STRIPE_PRICE_ID_PRO="price_..."

# Upstash Redis
UPSTASH_REDIS_REST_URL="https://..."
UPSTASH_REDIS_REST_TOKEN="..."

# UploadThing (optional)
UPLOADTHING_SECRET="sk_live_..."
UPLOADTHING_APP_ID="..."

# Supabase (optional - if using Supabase Auth & Storage)
# NEXT_PUBLIC_SUPABASE_URL="https://xxx.supabase.co"
# NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
# SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
